# ---- LLMs (both free tiers; Groq is primary, Gemini is the fallback) ----
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ---- Web search for the agent (Tavily first, SerpApi as backup) ----
TAVILY_API_KEY=
SERPAPI_KEY=

# ---- Auth / DB ----
JWT_SECRET=change-me-to-a-long-random-string
# SQLite by default. For Supabase Postgres use the pooled connection string, e.g.
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./nightfield.db

# ---- CORS ----
FRONTEND_ORIGIN=http://localhost:3000

# ---- Optional ----
# REDIS_URL=redis://localhost:6379/0
# USE_GROQ_SENTIMENT=false
# CHAT_RATE_LIMIT_PER_MIN=20
# TRUST_PROXY=false
LOG_LEVEL=INFO
